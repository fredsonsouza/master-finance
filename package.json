{
  "name": "master-admin",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @saas/api env:load prisma generate",
    "build": "turbo run build --no-cache",
    "dev": "turbo run dev",
    "check-types": "pnpm --filter @saas/api exec tsc --noEmit",
    "test": "pnpm --filter @saas/api test",
    "db:migrate:deploy": "pnpm --filter @saas/api db:migrate:deploy",
    "quality": "pnpm check-types && pnpm test && pnpm build",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
