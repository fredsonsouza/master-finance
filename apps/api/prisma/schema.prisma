generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  FINANCIAL
  SELLER
  COLLECTOR
  FISCAL
  INVENTORY
}

enum TransactionType {
  ENTRY
  EXIT
}

model User {
  id            String  @id @default(uuid())
  name          String
  username      String  @unique
  password_hash       String  @map("password_hash")
  recoveryEmail       String? @unique
  forcePasswordChange Boolean @default(false)
  avatarUrl           String?
  role          Role    @default(EMPLOYEE)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  cashClosures CashClosure[]

  collectionsAsCollector Collection[] @relation("CollectionCollector")
  collectionsAsCreator   Collection[] @relation("CollectionCreator")
  auditLogs              AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Unit {
  id   String @id @default(uuid())
  name String

  users        User[]
  transactions Transaction[]
  cashClosures CashClosure[]
  collections  Collection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

model Sector {
  id   String @id @default(uuid())
  name String

  items Item[]
  cashClosures CashClosure[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sectors")
}

model Item {
  id          String  @id @default(uuid())
  name        String
  description String?
  quantity    Int     @default(0)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("items")
}

model Transaction {
  id       String          @id @default(uuid())
  type     TransactionType
  date     DateTime // Data do registro (ex: quando o item entrou/saiu)
  month    String // Referência para o relatório mensal (ex: "2026-05")
  value    Float // Valor monetário
  quantity Int // Quantidade

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  batchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

enum CashClosureStatus {
  OPEN
  CLOSED
}

model CashClosure {
  id          String            @id @default(uuid())
  cashDate    DateTime // The date the cash register refers to
  value       Float // Total value of the register closure
  observation String? // Optional observation text
  status      CashClosureStatus @default(OPEN)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cash_closures")
}

model Collection {
  id              String   @id @default(uuid())
  requestDate     DateTime
  patientCode     String
  patientName     String
  exams           String[]
  reason          String   @db.VarChar(120)

  collectorId     String
  collector       User     @relation("CollectionCollector", fields: [collectorId], references: [id])

  pendingBy       String
  notifiedBy      String

  unitId          String
  unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  userId          String
  user            User     @relation("CollectionCreator", fields: [userId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("collections")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String   // e.g., "CREATE", "UPDATE", "DELETE"
  resource   String   // e.g., "USER", "UNIT", "SECTOR", "ITEM", "TRANSACTION", "CASH_CLOSURE", "COLLECTION", "AUTH"
  resourceId String?
  details    String

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("audit_logs")
}
