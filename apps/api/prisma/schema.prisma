generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  FINANCIAL
  SELLER
  COLLECTOR
  FISCAL
  INVENTORY
  ANALYST
}

enum TransactionType {
  ENTRY
  EXIT
}

model User {
  id                  String  @id @default(uuid())
  name                String
  username            String  @unique
  password_hash       String  @map("password_hash")
  recoveryEmail       String? @unique
  forcePasswordChange Boolean @default(false)
  avatarUrl           String?
  role                Role    @default(EMPLOYEE)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  cashClosures CashClosure[]

  collectionsAsCollector Collection[] @relation("CollectionCollector")
  collectionsAsCreator   Collection[] @relation("CollectionCreator")
  auditLogs              AuditLog[]
  evaluations            Evaluation[]
  hrReports              HrReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Unit {
  id   String @id @default(uuid())
  name String

  users        User[]
  transactions Transaction[]
  cashClosures CashClosure[]
  collections  Collection[]
  evaluations  Evaluation[]
  hrReports    HrReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

model Sector {
  id   String @id @default(uuid())
  name String

  items        Item[]
  cashClosures CashClosure[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sectors")
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Item {
  id          String  @id @default(uuid())
  name        String
  description String?
  value       Float   @default(0)
  quantity    Int     @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("items")
}

model Transaction {
  id       String          @id @default(uuid())
  type     TransactionType
  date     DateTime // Data do registro (ex: quando o item entrou/saiu)
  month    String // Referência para o relatório mensal (ex: "2026-05")
  value    Float // Valor monetário unitário
  quantity Int // Quantidade

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  batchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId, month, type])
  @@index([itemId, unitId, date])
  @@index([unitId, date, id])
  @@index([sectorId])
  @@index([userId])
  @@index([batchId])
  @@index([date(sort: Desc)])
  @@index([unitId, type, date(sort: Desc)])
  @@map("transactions")
}

enum CashClosureStatus {
  OPEN
  CLOSED
}

model CashClosure {
  id          String            @id @default(uuid())
  cashDate    DateTime // The date the cash register refers to
  value       Float // Total value of the register closure
  observation String? // Optional observation text
  status      CashClosureStatus @default(OPEN)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId, status, cashDate])
  @@index([sectorId])
  @@index([userId])
  @@map("cash_closures")
}

model Collection {
  id          String   @id @default(uuid())
  requestDate DateTime
  patientCode String
  patientName String
  exams       String[]
  reason      String   @db.VarChar(120)

  collectorId String
  collector   User     @relation("CollectionCollector", fields: [collectorId], references: [id], onDelete: Restrict)

  pendingBy  String
  notifiedBy String

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("CollectionCreator", fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId, requestDate])
  @@index([collectorId])
  @@index([userId])
  @@map("collections")
}

model AuditLog {
  id         String  @id @default(uuid())
  action     String // e.g., "CREATE", "UPDATE", "DELETE"
  resource   String // e.g., "USER", "UNIT", "SECTOR", "ITEM", "TRANSACTION", "CASH_CLOSURE", "COLLECTION", "AUTH"
  resourceId String?
  details    String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resource, action, createdAt])
  @@map("audit_logs")
}

enum EvaluationRating {
  EXCELLENT
  GOOD
  REGULAR
  BAD
}

model Evaluation {
  id       String @id @default(uuid())
  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  clientName    String?
  rating        EvaluationRating
  presetComment String?
  observation   String?

  createdAt DateTime @default(now())

  @@index([sellerId, createdAt])
  @@index([unitId, createdAt])
  @@map("evaluations")
}

enum ReportStatus {
  DRAFT
  SENT
}

model HrReport {
  id         String       @id @default(uuid())
  title      String
  content    String       @db.Text
  reportDate DateTime     // Data referente ao relatório (ex: 29/08/2026)
  status     ReportStatus @default(DRAFT)
  sentAt     DateTime?    // Capturado automaticamente no momento do envio

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  sector String? // Setor informado livremente pelo próprio usuário

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, reportDate])
  @@index([unitId, reportDate])
  @@index([status, sentAt])
  @@map("hr_reports")
}
