generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  FINANCIAL
  SELLER
  COLLECTOR
  FISCAL
  INVENTORY
  ANALYST
  HR
}

enum TransactionType {
  ENTRY
  EXIT
}

model User {
  id                  String  @id @default(uuid())
  name                String
  username            String  @unique
  password_hash       String  @map("password_hash")
  recoveryEmail       String? @unique
  forcePasswordChange Boolean @default(false)
  avatarUrl           String?
  role                Role    @default(EMPLOYEE)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  cashClosures CashClosure[]

  collectionsAsCollector Collection[] @relation("CollectionCollector")
  collectionsAsCreator   Collection[] @relation("CollectionCreator")
  auditLogs              AuditLog[]
  evaluations            Evaluation[]
  hrReports              HrReport[]

  employee                Employee?         @relation("UserEmployeeProfile")
  createdEmployees        Employee[]        @relation("EmployeeCreator")
  requestedDocuments      EmployeeRequest[] @relation("DocumentRequester")
  issuedEmployeeDocuments EmployeeRequest[] @relation("DocumentIssuer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Unit {
  id   String @id @default(uuid())
  name String

  users            User[]
  transactions     Transaction[]
  cashClosures     CashClosure[]
  collections      Collection[]
  evaluations      Evaluation[]
  hrReports        HrReport[]
  employees        Employee[]
  employeeRequests EmployeeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

model Sector {
  id   String @id @default(uuid())
  name String

  items        Item[]
  cashClosures CashClosure[]
  transactions Transaction[]
  employees    Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sectors")
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Item {
  id          String  @id @default(uuid())
  name        String
  description String?
  value       Float   @default(0)
  quantity    Int     @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("items")
}

model Transaction {
  id       String          @id @default(uuid())
  type     TransactionType
  date     DateTime // Data do registro (ex: quando o item entrou/saiu)
  month    String // Referência para o relatório mensal (ex: "2026-05")
  value    Float // Valor monetário unitário
  quantity Int // Quantidade

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  batchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId, month, type])
  @@index([itemId, unitId, date])
  @@index([unitId, date, id])
  @@index([sectorId])
  @@index([userId])
  @@index([batchId])
  @@index([date(sort: Desc)])
  @@index([unitId, type, date(sort: Desc)])
  @@map("transactions")
}

enum CashClosureStatus {
  OPEN
  CLOSED
}

model CashClosure {
  id          String            @id @default(uuid())
  cashDate    DateTime // The date the cash register refers to
  value       Float // Total value of the register closure
  observation String? // Optional observation text
  status      CashClosureStatus @default(OPEN)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId, status, cashDate])
  @@index([cashDate(sort: Desc)])
  @@index([unitId, cashDate(sort: Desc)])
  @@index([sectorId])
  @@index([userId])
  @@map("cash_closures")
}

model Collection {
  id          String   @id @default(uuid())
  requestDate DateTime
  patientCode String
  patientName String
  exams       String[]
  reason      String   @db.VarChar(120)

  collectorId String
  collector   User     @relation("CollectionCollector", fields: [collectorId], references: [id], onDelete: Restrict)

  pendingBy  String
  notifiedBy String

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("CollectionCreator", fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId, requestDate])
  @@index([collectorId])
  @@index([userId])
  @@map("collections")
}

model AuditLog {
  id         String  @id @default(uuid())
  action     String // e.g., "CREATE", "UPDATE", "DELETE"
  resource   String // e.g., "USER", "UNIT", "SECTOR", "ITEM", "TRANSACTION", "CASH_CLOSURE", "COLLECTION", "AUTH"
  resourceId String?
  details    String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resource, action, createdAt])
  @@map("audit_logs")
}

enum EvaluationRating {
  EXCELLENT
  GOOD
  REGULAR
  BAD
}

model Evaluation {
  id       String @id @default(uuid())
  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  clientName    String?
  rating        EvaluationRating
  presetComment String?
  observation   String?

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([unitId, createdAt(sort: Desc)], map: "evaluations_unitId_createdAt_desc_idx")
  @@index([sellerId, createdAt(sort: Desc)], map: "evaluations_sellerId_createdAt_desc_idx")
  @@index([unitId, rating, createdAt])
  @@index([sellerId, createdAt])
  @@index([unitId, createdAt])
  @@map("evaluations")
}

enum ReportStatus {
  DRAFT
  SENT
}

model HrReport {
  id         String       @id @default(uuid())
  title      String
  content    String       @db.Text
  reportDate DateTime     // Data referente ao relatório (ex: 29/08/2026)
  status     ReportStatus @default(DRAFT)
  sentAt     DateTime?    // Capturado automaticamente no momento do envio

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  sector String? // Setor informado livremente pelo próprio usuário

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, reportDate])
  @@index([unitId, reportDate])
  @@index([status, sentAt])
  @@map("hr_reports")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeDocumentType {
  DECLARATION
  WARNING
  RECEIPT
}

enum EmployeeRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model Employee {
  id                 String         @id @default(uuid())
  registrationNumber String         @unique // e.g., MASTER-JSS0001
  esocialCode        String?
  status             EmployeeStatus @default(ACTIVE)

  // Dados do Empregador (padrão GERENCIACLIN LTDA)
  employerName    String @default("GERENCIACLIN LTDA")
  employerCnpj    String @default("59.162.564/0001-73")
  employerAddress String @default("Rua IVONE PINHEIRO, 1590, SALA 08, TANCREDO NEVES, BOA VISTA, RR")

  // Identificação Pessoal e Residência
  fullName      String
  photoUrl      String?
  birthDate     DateTime?
  birthPlace    String?
  nationality   String?   @default("Brasileira")
  maritalStatus String?
  raceColor     String?
  fatherName    String?
  motherName    String?
  address       String?
  zipCode       String?
  landlinePhone String?
  mobilePhone   String?
  email         String?
  beneficiaries Json? // Array de dependentes/beneficiários

  // Documentação Legal
  cpf                String    @unique
  rgNumber           String?
  rgIssueDate        DateTime?
  rgIssuer           String?
  ctpsNumber         String?
  ctpsSeries         String?
  ctpsIssueDate      DateTime?
  ctpsState          String?   @default("RR")
  voterRegistration  String?
  voterZone          String?
  voterSection       String?
  cnhNumber          String?
  cnhCategory        String?
  militaryDoc        String?
  militaryCategory   String?
  classCouncilNumber String?

  // Admissão, Contrato, FGTS e PIS
  admissionDate         DateTime
  roleTitle             String // Função
  cboCode               String?
  salary                Float    @default(0)
  paymentType           String?  @default("Mensal")
  workHoursSummary      String?
  breakHoursSummary     String?
  fgtsOptionDate        DateTime?
  fgtsRectificationDate DateTime?
  fgtsBankAccount       String?
  pisRegistrationDate   DateTime?
  pisNumber             String?
  pisBankName           String?
  pisBankNumber         String?
  pisBankBranch         String?
  pisBankAddress        String?

  // Quadros Históricos (Página 1) e Horário Semanal (Página 2)
  workSchedule              Json? // Grade de Dom a Sab (Tipo, Entrada, S. Intervalo, E. Intervalo, Saída)
  salaryRoleHistory         Json? // Alterações de salário, cargo e/ou função
  vacationsHistory          Json? // Férias: Período aquisitivo, gozo e abono
  occupationalHealthHistory Json? // Acidentes de trabalho, doenças ou doenças profissionais
  unionContributions        Json? // Contribuição sindical
  generalObservations       String? @db.Text

  // Rescisão / Desligamento
  terminationDate  DateTime?
  terminationType  String?
  terminationNotes String? @db.Text

  // Relacionamentos no Sistema
  userId String? @unique
  user   User?   @relation("UserEmployeeProfile", fields: [userId], references: [id], onDelete: SetNull)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("EmployeeCreator", fields: [createdById], references: [id], onDelete: Restrict)

  requests EmployeeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, fullName])
  @@index([unitId, status])
  @@index([sectorId])
  @@index([registrationNumber])
  @@index([cpf])
  @@map("employees")
}

model EmployeeRequest {
  id          String                @id @default(uuid())
  type        EmployeeDocumentType
  subtype     String // ex.: "DECLARACAO_VINCULO", "DECLARACAO_HORARIO", "ADVERTENCIA_ESCRITA", "SUSPENSAO", "RECIBO_VALE", "RECIBO_EPI"
  title       String
  description String                @db.Text
  status      EmployeeRequestStatus @default(OPEN)

  amount          Float? // Para recibos financeiros
  referenceDate   DateTime  @default(now())
  templateData    Json? // Dados extras do template (ex.: dias de suspensão, itens de EPI, finalidade)
  rejectionReason String?   @db.Text

  // Assinatura Eletrônica e Validação via QR Code
  verificationCode String?   @unique // ex.: MC-DOC-2026-8F9A2C (gerado ao finalizar)
  contentHash      String? // SHA-256 hash do documento assinado
  signedAt         DateTime?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  requestedById String
  requestedBy   User   @relation("DocumentRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  issuedById String?
  issuedBy   User?   @relation("DocumentIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status, createdAt(sort: Desc)])
  @@index([requestedById, createdAt(sort: Desc)])
  @@index([status, type, createdAt(sort: Desc)])
  @@index([unitId, status])
  @@index([verificationCode])
  @@map("employee_requests")
}
